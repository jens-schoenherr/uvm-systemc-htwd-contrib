+class cvg2 : public covergroup {
+public:
+  CG_CONS(cvg2) { }
+
+  int sample_point = 0;
+
+  COVERPOINT(int, cvp, sample_point) {
+    bin<int> ("overlapping_bin",
+    11,
+    interval(12, 15),
+    interval(13, 17),
+    16)
+  };
+};
+
+TEST(bin_overlap,signed_integer_2) {
+
+  auto cntxt = fc4sc::global::create_new_context();
+
+  cvg2 cg("cg",__FILE__,__LINE__,cntxt);
+  EXPECT_EQ(cg.get_inst_coverage(),0);
+  cg.sample_point = 11;
+  cg.sample();
+  cg.sample_point = 17;
+  cg.sample();
+  EXPECT_EQ(cg.get_inst_coverage(),100);
+
+  // check bins
+  fc4sc::cvg_base_data_model *cgb = cg.get_cvg_data();
+  EXPECT_EQ(cgb->cvps.size(), 1u);
+  fc4sc::cvp_base_data_model *cpb = cgb->cvps[0];
+  fc4sc::coverpoint_data_model *cpt = dynamic_cast<fc4sc::coverpoint_data_model *>(cpb);
+  if (cpt != nullptr)
+  {
+    EXPECT_EQ(cpt->bins_data.size(), 1u);
+    fc4sc::bin_base_data_model *bn = cpt->bins_data[0];
+    EXPECT_NE(bn, nullptr);
+    if (bn != nullptr)
+    {
+      std::vector<fc4sc::interval_t<int>> intervals = bn->get_intervals_to_int();
+      EXPECT_EQ(intervals.size(), 2u);
+      EXPECT_EQ(intervals[0].first,  11);
+      EXPECT_EQ(intervals[0].second, 11);
+      EXPECT_EQ(intervals[1].first,  12);
+      EXPECT_EQ(intervals[1].second, 17);
+      std::vector<uint64_t> hits = bn->get_interval_hits();
+      EXPECT_EQ(hits.size(), 2u);
+      EXPECT_EQ(hits[0], 1u);
+      EXPECT_EQ(hits[1], 1u);
+    }
+  }
+  else
+  {
+     EXPECT_NE(cpt, nullptr);
+  }
+
+  std::string xml_name = "bin_overlap_" + std::string(::testing::UnitTest::GetInstance()->current_test_info()->name()) + ".xml";
+  xml_printer::coverage_save(xml_name, cntxt);
   fc4sc::global::delete_context(cntxt);
+  bool xml_equal = xml_compare::compare("ref_files/"+xml_name, xml_name);
+  EXPECT_TRUE(xml_equal);
 }
 
